# 复制本文件为 .env 并按需修改（.env 不入库）

# 应用
APP_NAME=LIMS
DEBUG=true

# 数据库连接串（开发期用 SQLite；后期切 MySQL 时改这里并启用 asyncmy）
DATABASE_URL=sqlite+aiosqlite:///./data/lims.db

# 文件上传目录（部署环境如 /data/uploads）
UPLOAD_DIR=/data/uploads

# 安全密钥：生产环境务必替换为随机字符串
SECRET_KEY=change-me-to-a-random-secret

# CORS 允许来源（逗号分隔，前端开发端口）
CORS_ORIGINS=http://localhost:5173